# Local development only. On Zerops these are injected from the project's
# environment variables and envSecrets — see zerops-project-import.yaml.

# Neo4j (docker-compose.dev.yml uses these defaults)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=devpassword

# Groq — free tier at https://console.groq.com
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxx

# Optional overrides
LLM_MODEL=llama-3.3-70b-versatile
CORS_ORIGINS=*
