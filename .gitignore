# Secrets — never commit.
# Note the .env.* line: `*.env` alone matches only files ENDING in .env, so a
# file like `.env.local` or `.env.production` would sail straight past it.
.env
*.env
.env.*
!.env.example
.mcp.json

# Python
__pycache__/
*.py[cod]
venv/
.venv/
vendor/
*.egg-info/

# Node
node_modules/
dist/
.vite/

# Neo4j local dev data
neo4j-data/
neo4j-logs/

# OS / editor
.DS_Store
.idea/
.vscode/
*.swp

# Logs
*.log
